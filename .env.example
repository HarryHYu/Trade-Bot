# Copy to .env on the server. Never commit .env.
ANTHROPIC_API_KEYS=sk-ant-key-from-org-1,sk-ant-key-from-org-2
MONTHLY_CREDIT_USD_PER_KEY=200
MONTHLY_SPEND_CAP_USD=600

ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
TRADING_LIVE_CONFIRM=

APPROVAL_MODE=manual
AUTO_APPROVE_MAX_USD=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
